<mujoco model="exo_arm">
  <compiler angle="degree" autolimits="true"/>
  <option timestep="0.002" gravity="0 0 -9.81" integrator="implicitfast"/>
  <statistic center="0.15 0.05 0.95" extent="0.9"/>

  <visual>
    <global azimuth="90" elevation="-12" offwidth="1280" offheight="720"/>
    <quality shadowsize="4096" offsamples="8"/>
    <map shadowclip="0.8" shadowscale="0.5"/>
    <headlight ambient="0.25 0.25 0.25" diffuse="0.35 0.35 0.35" specular="0.1 0.1 0.1"/>
  </visual>

  <asset>
    <texture name="sky" type="skybox" builtin="gradient" rgb1="0.32 0.40 0.52" rgb2="0.04 0.05 0.07" width="512" height="512"/>
    <texture name="grid" type="2d" builtin="checker" rgb1="0.20 0.22 0.25" rgb2="0.16 0.18 0.20" width="512" height="512" mark="edge" markrgb="0.32 0.34 0.38"/>
    <material name="floor" texture="grid" texrepeat="10 10" reflectance="0.2"/>
    <material name="skin" rgba="0.86 0.66 0.54 1" specular="0.25" shininess="0.3"/>
    <material name="shirt" rgba="0.22 0.28 0.38 1" specular="0.1"/>
    <material name="exo_metal" rgba="0.17 0.18 0.20 1" specular="0.9" shininess="0.9" reflectance="0.05"/>
    <material name="exo_accent" rgba="0.95 0.45 0.10 1" specular="0.6" shininess="0.7"/>
    <material name="target" rgba="0.95 0.12 0.18 0.75" emission="0.6"/>
  </asset>

  <default>
    <geom contype="0" conaffinity="0"/>
    <joint type="hinge" axis="0 -1 0" damping="0.5" armature="0.01"/>
    <default class="exo">
      <geom material="exo_metal"/>
    </default>
  </default>

  <worldbody>
    <light name="key" directional="true" pos="1 -2 3" dir="-0.3 0.6 -1" castshadow="true" diffuse="0.75 0.75 0.75" specular="0.3 0.3 0.3"/>
    <light name="fill" directional="true" pos="-2 -1 2" dir="0.6 0.3 -0.6" castshadow="false" diffuse="0.25 0.25 0.3"/>
    <geom name="floor" type="plane" size="3 3 0.1" material="floor"/>
    <camera name="side" pos="0.15 -2.1 1.12" xyaxes="1 0 0 0 0 1"/>

    <!-- Seated wearer (static, visual only) -->
    <geom name="stool_seat" type="cylinder" pos="0 0.21 0.44" size="0.2 0.025" material="exo_metal"/>
    <geom name="stool_post" type="cylinder" fromto="0 0.21 0 0 0.21 0.42" size="0.03" material="exo_metal"/>
    <geom name="stool_base" type="cylinder" pos="0 0.21 0.01" size="0.22 0.01" material="exo_metal"/>
    <geom name="torso" type="capsule" fromto="0 0.21 0.6 0 0.21 1.1" size="0.13" material="shirt"/>
    <geom name="neck" type="capsule" fromto="0 0.21 1.2 0 0.21 1.3" size="0.045" material="skin"/>
    <geom name="head" type="sphere" pos="0 0.21 1.4" size="0.1" material="skin"/>
    <geom name="thigh_l" type="capsule" fromto="0 0.13 0.53 0.4 0.13 0.53" size="0.065" material="shirt"/>
    <geom name="thigh_r" type="capsule" fromto="0 0.29 0.53 0.4 0.29 0.53" size="0.065" material="shirt"/>
    <geom name="shin_l" type="capsule" fromto="0.42 0.13 0.5 0.42 0.13 0.06" size="0.05" material="shirt"/>
    <geom name="shin_r" type="capsule" fromto="0.42 0.29 0.5 0.42 0.29 0.06" size="0.05" material="shirt"/>

    <!-- Exoskeleton frame on the back (static) -->
    <geom name="back_plate" class="exo" type="box" pos="-0.16 0.21 0.95" size="0.015 0.12 0.25"/>
    <geom name="shoulder_bracket" class="exo" type="box" pos="-0.16 0.055 1.2" size="0.015 0.145 0.02"/>
    <geom name="shoulder_arm" class="exo" type="box" pos="-0.08 -0.09 1.2" size="0.08 0.012 0.018"/>
    <geom name="shoulder_motor" class="exo" type="cylinder" fromto="0 -0.115 1.2 0 -0.07 1.2" size="0.045"/>
    <geom name="shoulder_motor_ring" type="cylinder" fromto="0 -0.118 1.2 0 -0.112 1.2" size="0.047" material="exo_accent"/>

    <body name="upper_arm" pos="0 0 1.2">
      <joint name="shoulder" range="-30 150"/>
      <geom name="upper_arm_geom" type="capsule" fromto="0 0 0 0 0 -0.33" size="0.04" mass="2.0" material="skin"/>
      <!-- Exo link on the upper arm -->
      <geom name="upper_strut" class="exo" type="box" pos="0 -0.065 -0.165" size="0.012 0.008 0.15" mass="0.15"/>
      <geom name="upper_cuff_1" class="exo" type="cylinder" pos="0 0 -0.08" size="0.052 0.012" mass="0.05"/>
      <geom name="upper_cuff_2" class="exo" type="cylinder" pos="0 0 -0.25" size="0.05 0.012" mass="0.05"/>
      <geom name="elbow_motor" class="exo" type="cylinder" fromto="0 -0.11 -0.33 0 -0.07 -0.33" size="0.035" mass="0.35"/>
      <geom name="elbow_motor_ring" type="cylinder" fromto="0 -0.113 -0.33 0 -0.107 -0.33" size="0.037" mass="0.0" material="exo_accent"/>

      <body name="forearm" pos="0 0 -0.33">
        <joint name="elbow" range="0 145"/>
        <geom name="forearm_geom" type="capsule" fromto="0 0 0 0 0 -0.26" size="0.035" mass="1.5" material="skin"/>
        <!-- Exo link on the forearm -->
        <geom name="forearm_strut" class="exo" type="box" pos="0 -0.065 -0.12" size="0.012 0.008 0.12" mass="0.12"/>
        <geom name="forearm_cuff_1" class="exo" type="cylinder" pos="0 0 -0.06" size="0.047 0.012" mass="0.05"/>
        <geom name="forearm_cuff_2" class="exo" type="cylinder" pos="0 0 -0.2" size="0.044 0.012" mass="0.05"/>
        <site name="hand" pos="0 0 -0.26" size="0.015" rgba="1 0.85 0.1 1"/>
      </body>
    </body>

    <body name="target" mocap="true" pos="0.3 0 1.0">
      <geom name="target_geom" type="sphere" size="0.025" material="target"/>
    </body>
  </worldbody>

  <actuator>
    <motor name="shoulder_motor" joint="shoulder" gear="30" ctrlrange="-1 1"/>
    <motor name="elbow_motor" joint="elbow" gear="15" ctrlrange="-1 1"/>
  </actuator>
</mujoco>